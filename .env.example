# CONFIGURACIÓN DE BASE DE DATOS
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# CONFIGURACIÓN DE LA APLICACIÓN
# Valores por defecto seguros: si este archivo se copia sin revisar,
# el resultado es una configuración de producción, no una de depuración.
# Para desarrollo local cambia a: APP_ENV=development y APP_DEBUG=true
# (APP_DEBUG=true solo hace que la página de error de BD muestre el
#  mensaje técnico de PostgreSQL; no activa ningún otro modo depuración).
APP_ENV=production
APP_DEBUG=false

# CONFIGURACIÓN DE CORREO ELECTRÓNICO
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@simco.com
MAIL_FROM_NAME="SIMCO - Sistema de PQRSF"
